---
/**
 * Supporting cast grid refactored with design system primitives.
 */

import "./characters.css";
import Grid from "@/design/ui/layout/Grid.astro";
import CastItem from "./CastItem.astro";

import type { CastItemData } from "./characters";

interface Props {
  items: CastItemData[];
  links?: Record<string, string>;
}

const { items, links = {} } = Astro.props;
---

<Grid cols={2} gap="sm" class="cast-grid-wrapper">
  {items.map((item) => <CastItem item={item} href={links[item.name]} />)}
</Grid>

<style>
  @media (max-width: 900px) {
    .cast-grid-wrapper {
      grid-template-columns: 1fr !important;
    }
  }
</style>
