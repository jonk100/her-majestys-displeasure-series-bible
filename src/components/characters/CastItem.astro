---
/**
 * Supporting cast item refactored with design system primitives.
 */

import "./characters.css";
import Stack from "@/design/ui/layout/Stack.astro";
import Inline from "@/design/ui/layout/Inline.astro";
import Image from "@/design/ui/primitives/Image.astro";
import Text from "@/design/ui/typography/Text.astro";

import type { CastItemData } from "./characters";

interface Props {
  item: CastItemData;
  href?: string;
}

const { item, href } = Astro.props;
---

{
  href ? (
    <a href={href} class="cast-item-link">
      <article class="cast-item">
        <Inline gap="md" align="start" wrap={false} class="cast-item__inner">
          <Image
            src={item.image}
            alt={item.name}
            shape="portrait"
            radius="sm"
            class="cast-item__image"
          />
          <Stack gap="xs" class="cast-item__content">
            <Text type="h4" class="cast-item__name">
              {item.name}
            </Text>
            <Text type="label" tone="accent" class="cast-item__tag">
              {item.tag}
            </Text>
            <Text type="body-sm" tone="subtle" class="cast-item__description">
              {item.description}
            </Text>
          </Stack>
        </Inline>
      </article>
    </a>
  ) : (
    <article class="cast-item">
      <Inline gap="md" align="start" wrap={false} class="cast-item__inner">
        <Image
          src={item.image}
          alt={item.name}
          shape="portrait"
          radius="sm"
          class="cast-item__image"
        />
        <Stack gap="xs" class="cast-item__content">
          <Text type="h4" class="cast-item__name">
            {item.name}
          </Text>
          <Text type="label" tone="accent" class="cast-item__tag">
            {item.tag}
          </Text>
          <Text type="body-sm" tone="subtle" class="cast-item__description">
            {item.description}
          </Text>
        </Stack>
      </Inline>
    </article>
  )
}

<style>
  .cast-item {
    width: 100%;
    padding: var(--space-4);
    background: var(--bg-subtle);
    border: 1px solid var(--border-faint);
    transition: background-color 0.2s ease;
  }

  .cast-item:hover {
    background: var(--bg3);
  }

  .cast-item__image {
    width: 120px !important;
    margin: 0 !important;
  }

  .cast-item__name {
    margin: 0;
    color: var(--text);
  }

  .cast-item__tag {
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    opacity: 0.8;
  }

  .cast-item__description {
    line-height: 1.5;
  }

  @media (max-width: 480px) {
    .cast-item__inner {
      flex-direction: column !important;
    }
    
    .cast-item__image {
      width: 100% !important;
      height: 240px !important;
    }
  }

  .cast-item-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
</style>
