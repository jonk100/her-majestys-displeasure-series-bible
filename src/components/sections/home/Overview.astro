---
/**
 * Overview section refactored with design system primitives.
 */

import Section from '../../layout/Section.astro';
import SectionLabel from '@/design/ui/typography/SectionLabel.astro';
import Text from '@/design/ui/typography/Text.astro';
import Stack from '@/design/ui/layout/Stack.astro';
import CompStrip from '../../ui/CompStrip.astro';

import { premiseParagraphs, comparisons } from '@/data/her-majestys-displeasure';

---

<Section variant="black" spacing="lg">
  <Stack gap="xl">
    <Stack gap="md">
      <SectionLabel text="The Premise" tone="accent" />
      <Text as="h2" type="h2">Power <em>vs.</em> Art</Text>
    </Stack>
    
    <Stack gap="lg">
      {premiseParagraphs.map((p) => (
        <Text type="body" tone="subtle" set:html={p} />
      ))}
    </Stack>

    <CompStrip items={comparisons} />
  </Stack>
</Section>
