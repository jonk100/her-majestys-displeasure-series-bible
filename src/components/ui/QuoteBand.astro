---
interface Props {
  fontSize?: string;
}

const { fontSize } = Astro.props;
---

<div class="quote-band">
  <pre class="quote-text" style={`font-size: ${fontSize};`}>
    <slot />
  </pre>
</div>

<style>
  .quote-band {
    max-width: 760px;
    background: linear-gradient(90deg,var(--bg1), transparent);
    padding: var(--space-2) var(--space-2);
    border-top: 2px solid var(--bg4);
    border-bottom: 2px solid var(--bg4);
    margin: 0;
    border-left: 3px solid var(--accent-blue);

  }

  .quote-text {
    max-width: var(--container-width);
    margin: 0 auto;
    font-family: var(--font-mono);
    font-size: var(--fs-xxxl);
    line-height: var(--lh-normal);
    color: var(--text-muted);
    letter-spacing: 0.03rem;
    white-space: pre-wrap;
    overflow: hidden;
    padding: var(--space-2) 0 0 var(--space-5);
  }
</style>
