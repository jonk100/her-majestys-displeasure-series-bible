  .threat-band {
    /* background: var(--bg); */
    /* padding: var(--space-3) var(--space-5); */
  }

  .threat-header {
    max-width: var(--container-width);
    margin: 0 0;
    font-family: var(--font-mono);
    font-size: var(--fs0);
    line-height: 1.7;
    color: var(--red-text-muted);
    letter-spacing: 0.04rem;
    white-space: pre-wrap;
    overflow: hidden;
  }
</style>
