---
/**
 * Site footer.
 */
---

<footer class="footer">
  <div>Her Majesty's Displeasure · Series Bible</div>

  <div>Operation Minuet · File OM/1965/001</div>

  <div>6-Part Limited Series · Confidential</div>
</footer>

<style>
  .footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);

    padding: var(--space-6);

    border-top: var(--border-soft);

    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.14rem;
    text-transform: uppercase;

    color: var(--color-cream);
    opacity: 0.28;
  }

  @media (max-width: 700px) {
    .footer {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
