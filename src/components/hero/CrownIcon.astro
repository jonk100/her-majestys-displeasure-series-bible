---
/**
 * Decorative crown icon.
 */
---

<svg
  class="hero-crown"
  viewBox="0 0 80 52"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <path
    d="M40 4 L10 28 L20 48 L60 48 L70 28 Z"
    stroke="var(--color-amber)"
    stroke-width="1.5"
    fill="none"
    opacity="0.7"></path>

  <circle cx="40" cy="4" r="3" fill="var(--color-amber)" opacity="0.7"></circle>

  <circle cx="10" cy="28" r="3" fill="var(--color-amber)" opacity="0.7"></circle>

  <circle cx="70" cy="28" r="3" fill="var(--color-amber)" opacity="0.7"></circle>
</svg>

<style>
  .hero-crown {
    width: 48px;
    margin-inline: auto;
    margin-bottom: var(--space-4);

    opacity: 0.65;
  }
</style>
