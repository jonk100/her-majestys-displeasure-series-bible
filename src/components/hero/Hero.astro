---
/**
 * Hero section refactored with design system primitives.
 */

import Container from "@/design/ui/layout/Container.astro";
import Stack from "@/design/ui/layout/Stack.astro";
import Text from "@/design/ui/typography/Text.astro";
import PitchDeckCTA from "../pitchdeck/PitchDeckCTA.astro";

import CrownIcon from "./CrownIcon.astro";
import HeroMeta from "./HeroMeta.astro";

import "./hero.css";

import type { HeroData } from "./hero";

interface Props {
  data: HeroData;
}

const { data } = Astro.props;
---

<section class="hero">
  <Container>
    <Stack gap="lg" align="center">
      <!-- ICON -->
      <div class="hero__icon" aria-hidden="true">
        <CrownIcon />
      </div>

      <!-- TITLE BLOCK -->
      <Stack gap="xs" align="center">
        <Text as="h1" type="h1" class="hero__title">
          {data.title}
        </Text>

        <Text type="label" tone="accent" class="hero__subtitle">
          {data.subtitle}
        </Text>
      </Stack>

      <!-- LOG LINE -->
      <Text type="lead" tone="subtle" class="hero__logline">
        {data.logline}
      </Text>

      <!-- META -->
      <HeroMeta items={data.meta} />
      
      <!-- FILE REF -->
      <Text type="caption" tone="muted" class="hero__file-ref">
        {data.fileRef}
      </Text>

      <PitchDeckCTA />
    </Stack>
  </Container>
  <div class="hero__scroll-hint">
    <Text type="caption" tone="muted">↓ scroll ↓</Text>
  </div>
</section>

<style>
  /* Local overrides for the hero specific layout */
  .hero__title {
    text-align: center;
    /* Maintain the clamp from original hero.css if needed, or let primitive handle it */
  }
  
  .hero__scroll-hint {
    position: absolute;
    bottom: var(--space-6);
    left: 50%;
    transform: translateX(-50%);
    opacity: 0.5;
  }
</style>
