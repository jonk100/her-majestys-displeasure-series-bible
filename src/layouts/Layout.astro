---
import Head from "./Head.astro";
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={title} description="A personal blog about software development, technology, and programming." />
    <slot name="head" />
  </head>
  <body>
    <header>
      <slot name="header" />
    </header> 
    <slot />
  </body>
</html>
