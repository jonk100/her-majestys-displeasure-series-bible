---
import Layout from "../layouts/Layout.astro";
import Section from "../components/layout/Section.astro";
import Container from "../components/layout/Container.astro";
import Footer from "../components/layout/Footer.astro";
import ClassifiedBand from "../components/ui/ClassifiedBand.astro";
import PitchDeckNav from "../components/ui/PitchDeckNav.astro";
import CTA from "../components/ui/CTA.astro";
import Eyebrow from "../components/typography/Eyebrow.astro";
import Heading from "../components/typography/Heading.astro";
import Rule from "../components/typography/Rule.astro";
import "@/styles/global.css";
---

<Layout title="MI5 Executive Briefing — Cultural Soft-Power vs. Imperial Prestige">
  <ClassifiedBand label="TOP SECRET — MI5 EXECUTIVE BRIEFING // INCIPIENT THREAT EVALUATION" />

  <!-- ─── PAGE HEADER ─── -->
  <Section variant="black" spacing="sm">
    <Container>
      <Eyebrow>Executive Briefing</Eyebrow>
      <Heading level={2} variant="section">The <em>Hook</em></Heading>
      <Rule />
    </Container>
  </Section>

  <!-- ─── INCIPIENT THREAT BAND ─── -->
  <div class="threat-band">
    <pre class="threat-header">
----------------------------------------------------------------------------------------
MI5 EXECUTIVE BRIEFING // INCIPIENT THREAT EVALUATION
CULTURAL SOFT-POWER VS. IMPERIAL PRESTIGE
----------------------------------------------------------------------------------------
    </pre>
  </div>

  <!-- ─── HARD SPLIT-SCREEN ─── -->
  <div class="hook-split">
    <!-- LEFT: PRINCE PHILIP -->
    <div class="hook-half hook-half--philip">
      <div class="hook-portrait">
        <img
          class="hook-image"
          src="/phillip-hookpage.jpg"
          alt="Prince Philip — Full Naval Dress Uniform"
          loading="eager"
        />
        <div class="hook-overlay"></div>
        <div class="hook-label">THE ESTABLISHMENT</div>
      </div>
    </div>

    <!-- RIGHT: JOHN LENNON -->
    <div class="hook-half hook-half--lennon">
      <div class="hook-portrait">
        <img
          class="hook-image"
          src="/john-hookpage.jpg"
          alt="John Lennon — Peace Sign, 1965"
          loading="eager"
        />
        <div class="hook-overlay"></div>
        <div class="hook-label hook-label--lennon">THE REBELLION</div>
      </div>
    </div>

    <!-- ─── CENTER OVERLAY BOX ─── -->
    <div class="hook-center-box">
      <h3 class="logline-label">THE LOGLINE</h3>
      <p class="logline-text">
        When The Beatles are awarded MBEs in 1965, an offended Prince Philip
        responds to a flippant bathroom comment by quietly unleashing MI5 to
        neutralize the band as a political embarrassment. Caught between royal
        paranoia and John Lennon's explosive cultural authority, two hapless
        intelligence officers oversee a multi-year campaign of administrative
        sabotage — exposing how petty grudges, bad paperwork, and institutional
        absurdity can reshape history.
      </p>
    </div>
  </div>

  <!-- ─── WHY NOW? ─────────── -->
  <Section variant="paper" spacing="lg">
    <Container>
      <Eyebrow>Thesis</Eyebrow>
      <Heading level={2} variant="section">Why <em>Now?</em></Heading>
      <Rule />
      <p class="prose">
        We live in an era fascinated by the hidden machinery of institutional
        power, yet we are constantly reminded of the fragile egos managing it.
        <em>Her Majesty's Displeasure</em> is a dark, cynical satire that
        explores the ultimate cosmic farce: the grand British Empire wasting
        vast state intelligence apparatuses, spinning self-fulfilling
        cryptographic nightmares, and fighting a covert, multi-year domestic
        war against a rock-and-roll band — all to defend the wounded pride of
        a prince over a casual joke made in a royal lavatory.
      </p>
    </Container>
  </Section>

  <!-- ─── PHILIP QUOTE ─────────── -->
  <div class="quote-band">
    <pre class="quote-text">
"If the British Empire cannot successfully direct the movements of a skiffle band,
then what on Earth are we keeping the guards around for?" — PRINCE PHILIP
    </pre>
  </div>

  <!-- ─── PITCH DECK NAV ─── -->
  <PitchDeckNav current="/pitchhook" />

  <!-- ─── FOOTER ─── -->
  <Footer />
</Layout>

<style>
  /* ─── THREAT BAND ─── */
  .threat-band {
    background: var(--bg);
    padding: var(--space-3) var(--space-5);
    border-bottom: 2px solid var(--bg4);
  }

  .threat-header {
    max-width: var(--container-width);
    margin: 0 auto;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    line-height: 1.6;
    color: var(--accent-blue);
    letter-spacing: 0.04rem;
    white-space: pre-wrap;
    overflow: hidden;
  }

  /* ─── HARD SPLIT-SCREEN ─── */
  .hook-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    background: var(--bg);
    position: relative;
    overflow: hidden;
    min-height: 80vh;
  }

  .hook-half {
    position: relative;
    overflow: hidden;
  }

  .hook-portrait {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 70vh;
  }

  .hook-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    min-height: 70vh;
  }

  .hook-half--philip .hook-image {
    object-position: center 30%;
  }

  .hook-half--lennon .hook-image {
    object-position: center 40%;
  }

  .hook-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 60%,
      rgba(0, 0, 0, 0.85) 100%
    );
    pointer-events: none;
  }

  .hook-label {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.24rem;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    padding: 6px 14px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(4px);
    background: rgba(0, 0, 0, 0.3);
  }

  .hook-label--lennon {
    color: rgba(255, 255, 255, 0.7);
    border-color: rgba(255, 255, 255, 0.25);
  }

  /* ─── CENTER OVERLAY BOX ─── */
  .hook-center-box {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(0, 0, 0, 0.82);
    backdrop-filter: blur(8px);
    padding: var(--space-6) var(--space-6);
    z-index: 10;
    border-top: 1px solid rgba(200, 168, 75, 0.15);
  }

  .logline-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.3rem;
    text-transform: uppercase;
    color: var(--accent-blue);
    margin: 0 0 var(--space-3);
  }

  .logline-text {
    font-family: var(--font-sans);
    font-size: clamp(0.9rem, 1.5vw, 1.15rem);
    line-height: 1.65;
    color: var(--text1);
    margin: 0;
    max-width: 900px;
    margin-inline: auto;
    text-align: center;
    font-weight: 400;
  }

  /* ─── QUOTE BAND ─── */
  .quote-band {
    background: var(--bg2);
    padding: var(--space-5) var(--space-5);
    border-top: 2px solid var(--bg4);
    border-bottom: 2px solid var(--bg4);
  }

  .quote-text {
    max-width: var(--container-width);
    margin: 0 auto;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.8;
    color: var(--text-muted);
    letter-spacing: 0.03rem;
    text-align: center;
    white-space: pre-wrap;
    overflow: hidden;
    border-left: 2px solid var(--accent-blue);
    padding-left: var(--space-4);
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 800px) {
    .hook-split {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .hook-portrait {
      min-height: 40vh;
    }

    .hook-image {
      min-height: 40vh;
    }

    .hook-center-box {
      position: relative;
      padding: var(--space-4) var(--space-4);
    }

    .logline-text {
      font-size: 0.85rem;
      text-align: left;
    }
  }

  @media (max-width: 600px) {
    .hook-portrait {
      min-height: 30vh;
    }

    .hook-image {
      min-height: 30vh;
    }
  }
</style>