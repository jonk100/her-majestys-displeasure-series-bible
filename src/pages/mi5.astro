---
import Layout from "../layouts/Layout.astro";
import Section from "../components/layout/Section.astro";
import Container from "../components/layout/Container.astro";
import Footer from "../components/layout/Footer.astro";
import ClassifiedBand from "../components/ui/ClassifiedBand.astro";
import PitchDeckNav from "../components/ui/PitchDeckNav.astro";
import CTA from "../components/ui/CTA.astro";
import Eyebrow from "../components/typography/Eyebrow.astro";
import Heading from "../components/typography/Heading.astro";
import Rule from "../components/typography/Rule.astro";
import "@/styles/global.css";
---

<Layout title="MI5 — Operation Minuet Personnel Files">
  <ClassifiedBand label="TOP SECRET — MI5 OPERATION MINUET // PERSONNEL" />

  <!-- ─── PAGE HEADER ─── -->
  <Section variant="black" spacing="sm">
    <Container>
      <Eyebrow>Classified Personnel Records</Eyebrow>
      <Heading level={2} variant="section">The <em>Operatives</em></Heading>
      <Rule />
      <p class="prose page-intro">
        Two MI5 men. One a delusional artist manqué. One a weary conscience.
        Five years. The bureaucratic heart of the show.
      </p>
    </Container>
  </Section>

  <!-- ─── SPLIT-SCREEN PERSONNEL FILES ─── -->
  <div class="files-grid">
    <!-- ═══════════════════════════════════════════ -->
    <!-- NIGEL FINCH -->
    <!-- ═══════════════════════════════════════════ -->
    <div class="personnel-file">
      <!-- Paperclip visual -->
      <div class="paperclip" aria-hidden="true">
        <svg width="24" height="60" viewBox="0 0 24 60" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M6 2V48C6 51.3137 8.68629 54 12 54C15.3137 54 18 51.3137 18 48V10C18 6.68629 15.3137 4 12 4C8.68629 4 6 6.68629 6 10V46" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </div>

      <!-- Surveillance Photo -->
      <div class="photo-frame">
        <img
          class="surveillance-photo"
          src="/nigel_finch.png"
          alt="Surveillance photograph — FINCH, N."
          loading="lazy"
        />
        <div class="viewfinder-grid" aria-hidden="true"></div>
        <div class="label-tape">FINCH, N.</div>
      </div>

      <!-- Vital Statistics -->
      <div class="data-box">
        <span class="classified-redacted">CLASSIFIED // REDACTED</span>
        <pre class="vitals">
SECURITY CLEARANCE: LEVEL 4 (RESTRICTED)
DOCUMENT REF:       MI5-OP-MINUET-034
SUBJECT STATUS:     ACTIVE FIELD OPERATIVE / *EXILED (1980)
--------------------------------------------------------------
AGE:                48 [1965] / 53 [1970]
OCCUPATION:         MID-LEVEL ADMINISTRATIVE ESPIONAGE
PRIMARY WEAPON:     FORM 10-A EXPENSE REPORTS & TYPEWRITER RIBBON
        </pre>
      </div>

      <!-- Profile Content -->
      <div class="profile-body">
        <h3 class="agent-name">NIGEL FINCH <span class="agent-subtitle">// The Weary Realist</span></h3>

        <blockquote class="agent-quote">
          "I have exactly three years, four months, and twelve days until my government
          pension clears. If a rock-and-roll band costs me my rose garden, I will become
          an incredibly unreasonable man."
        </blockquote>

        <div class="agent-section">
          <span class="agent-section-label">The Logline Hook</span>
          <p>
            A world-weary, process-driven MI5 lifer who begins the mission desperately
            trying to avoid a crisis, only to end up as the conspiracy's quiet, intentional
            saboteur when the state demands blood.
          </p>
        </div>

        <div class="agent-section">
          <span class="agent-section-label">The Archetype</span>
          <p>
            The Only Sane Man in an Insane System. Nigel represents the tragic comedy of a
            fundamentally decent bureaucrat trapped in a completely indecent assignment.
          </p>
        </div>

        <div class="agent-section">
          <span class="agent-section-label">The Comedy DNA</span>
          <ul class="agent-list">
            <li>
              <strong>The Bureaucratic Absurdity:</strong> Navigates impossible, surreal
              counter-culture scenarios by sticking strictly to standardized civil service
              protocols.
            </li>
            <li>
              <strong>The Melancholic Precision:</strong> Speaks in a measured, monotone
              cadence. He treats a global rock-and-roll phenomenon with the same dry
              detachment as a nature documentary narrator watching his own career slowly
              implode.
            </li>
          </ul>
        </div>

        <div class="agent-section">
          <span class="agent-section-label">The Narrative Trajectory</span>
          <ul class="agent-list">
            <li>
              <strong>1965:</strong> Reluctantly accepts <em>Operation Minuet</em> with one
              goal: keep his head down, manage his pretentious partner, and protect his pension.
            </li>
            <li>
              <strong>1969:</strong> His quiet conscience finally breaks when the mission
              escalates from psychological "nudges" to an authorized state assassination
              (<em>Operation Elegy</em>). He weaponizes his greatest skill—bad paperwork and
              orchestrated logistical delays—to single-handedly tank the Crown's murder plot.
            </li>
            <li>
              <strong>1980:</strong> Exiled to a frozen administrative room in the Falklands,
              watching a lone madman achieve in a single afternoon what he spent five years
              formatting files to prevent.
            </li>
          </ul>
        </div>

        <!-- Redacted lines -->
        <div class="redacted-block">
          <span class="redacted-bar"></span>
          <span class="redacted-bar" style="width: 65%;"></span>
          <span class="redacted-bar" style="width: 80%;"></span>
        </div>
      </div>

      <!-- Ink Stamp -->
      <div class="ink-stamp nigel-stamp">PENSION<br/>PENDING</div>
    </div>

    <!-- ═══════════════════════════════════════════ -->
    <!-- CLIVE BARROW -->
    <!-- ═══════════════════════════════════════════ -->
    <div class="personnel-file">
      <!-- Paperclip visual -->
      <div class="paperclip" aria-hidden="true">
        <svg width="24" height="60" viewBox="0 0 24 60" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M6 2V48C6 51.3137 8.68629 54 12 54C15.3137 54 18 51.3137 18 48V10C18 6.68629 15.3137 4 12 4C8.68629 4 6 6.68629 6 10V46" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </div>

      <!-- Surveillance Photo -->
      <div class="photo-frame">
        <img
          class="surveillance-photo"
          src="/clive_barrow.png"
          alt="Surveillance photograph — BARROW, C."
          loading="lazy"
        />
        <div class="viewfinder-grid" aria-hidden="true"></div>
        <div class="label-tape">BARROW, C.</div>
      </div>

      <!-- Vital Statistics -->
      <div class="data-box">
        <span class="classified-redacted">CLASSIFIED // REDACTED</span>
        <pre class="vitals">
SECURITY CLEARANCE: LEVEL 4 (RESTRICTED)
DOCUMENT REF:       MI5-OP-MINUET-035
SUBJECT STATUS:     ACTIVE FIELD OPERATIVE / *EXILED (1980)
--------------------------------------------------------------
AGE:                41 [1965] / 46 [1970]
OCCUPATION:         MID-LEVEL ADMINISTRATIVE ESPIONAGE
PRIMARY WEAPON:     AESTHETIC PENETRATION PROTOCOLS / KLAUS
        </pre>
      </div>

      <!-- Profile Content -->
      <div class="profile-body">
        <h3 class="agent-name">CLIVE BARROW <span class="agent-subtitle">// The Delusional Visionary</span></h3>

        <blockquote class="agent-quote">
          "They call it pop music, Nigel. I call it an un-audited vector of psychological
          contagion. Infiltrating their circle isn't just surveillance—it is my magnum opus."
        </blockquote>

        <div class="agent-section">
          <span class="agent-section-label">The Logline Hook</span>
          <p>
            An eccentric, pretentious mid-level intelligence officer who treats a
            state-sanctioned surveillance assignment as his personal five-year artistic
            masterpiece, losing his mind to his own elaborate counter-intelligence theories.
          </p>
        </div>

        <div class="agent-section">
          <span class="agent-section-label">The Archetype</span>
          <p>
            The Ambitious Incompetent. Clive is the dangerous intersection of massive career
            insecurity and zero self-awareness, desperate to impress elites like Prince Philip
            and Lord Mountbatten.
          </p>
        </div>

        <div class="agent-section">
          <span class="agent-section-label">The Comedy DNA</span>
          <ul class="agent-list">
            <li>
              <strong>The Pretentious Farce:</strong> Invents ridiculous, over-complicated spy
              jargon (<em>"aesthetic penetration protocols," "psychological ricochet"</em>) to
              justify his bumbling fieldwork.
            </li>
            <li>
              <strong>The Undercover Mask:</strong> Adopts a highly flawed undercover persona
              — "Klaus," a deeply pretentious German art critic — to infiltrate John Lennon's
              avant-garde social circles, completely convinced he has everyone fooled.
            </li>
          </ul>
        </div>

        <div class="agent-section">
          <span class="agent-section-label">The Narrative Trajectory</span>
          <ul class="agent-list">
            <li>
              <strong>1965:</strong> Sees The Beatles assignment as his ticket out of
              bureaucratic mediocrity — a historical canvas waiting for his "genius."
            </li>
            <li>
              <strong>1968:</strong> Becomes utterly unhinged listening to hidden studio
              microphones. He stays awake for seventy-two straight hours meticulously charting
              the soundscape of <em>"Revolution 9,"</em> entirely convinced the tape reels
              hide encrypted Soviet launch codes.
            </li>
            <li>
              <strong>1980:</strong> Exiled to the exact same frozen room in the Falklands as
              Nigel. He still dresses as if he might encounter high-society art patrons,
              continuing to analyze the local sheep population using strict spy methodology.
            </li>
          </ul>
        </div>

        <!-- Redacted lines -->
        <div class="redacted-block">
          <span class="redacted-bar" style="width: 55%;"></span>
          <span class="redacted-bar" style="width: 75%;"></span>
          <span class="redacted-bar"></span>
        </div>
      </div>

      <!-- Ink Stamp -->
      <div class="ink-stamp clive-stamp">EVALUATION:<br/>UNSTABLE</div>
    </div>
  </div>

  <!-- ─── THE COMEDY OF ANTI-COMPETENCE ─────────── -->
  <Section variant="paper" spacing="lg">
    <Container>
      <Eyebrow>The Engine</Eyebrow>
      <Heading level={2} variant="section">The Comedy of <em>Anti-Competence</em></Heading>
      <Rule />
      <p class="prose">
        The engine of <em>Her Majesty's Displeasure</em> is the classic "Odd Couple"
        dynamic framed through an existential crisis.
      </p>
      <div class="odd-couple">
        <div class="odd-couple__item">
          <span class="odd-couple__label">Nigel</span>
          <p>is the machine operating perfectly within a broken framework.</p>
        </div>
        <div class="odd-couple__item">
          <span class="odd-couple__label">Clive</span>
          <p>is the wrench throwing itself into the gears, convinced it is improving the engine.</p>
        </div>
      </div>
      <p class="prose">
        They do not gather intelligence; they create self-fulfilling prophecies. When Clive's
        over-engineered schemes fail, they inadvertently spark the band's creative evolutions
        — such as Finch's clumsy attempt to plant Eastern literature accidentally triggering
        George Harrison's lifelong obsession with the sitar.
      </p>
    </Container>
  </Section>

  <!-- ─── PITCH DECK NAV ─── -->
  <PitchDeckNav current="/mi5" />

  <!-- ─── FOOTER ─── -->
  <Footer />
</Layout>

<style>
  /* ─── PAGE INTRO ─── */
  .page-intro {
    text-align: center;
    max-width: 600px;
    margin-inline: auto;
    color: var(--text-muted);
  }

  /* ─── FILES GRID ─── */
  .files-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    background: var(--bg);
  }

  /* ─── PERSONNEL FILE ─── */
  .personnel-file {
    position: relative;
    background: var(--bg2);
    padding: var(--space-5);
    border: var(--border-faint);
    font-family: var(--font-mono);
    overflow: hidden;
  }

  /* ─── PAPERCLIP ─── */
  .paperclip {
    position: absolute;
    top: 8px;
    right: 12px;
    color: var(--text-muted);
    opacity: 0.3;
    z-index: 2;
    pointer-events: none;
  }

  /* ─── SURVEILLANCE PHOTO ─── */
  .photo-frame {
    position: relative;
    margin-bottom: var(--space-4);
    border: 2px solid var(--bg4);
    overflow: hidden;
  }

  .surveillance-photo {
    width: 100%;
    height: 280px;
    object-fit: cover;
    display: block;
    filter: grayscale(100%) contrast(1.2) brightness(0.85);
  }

  .viewfinder-grid {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size: 20px 20px;
    pointer-events: none;
  }

  .label-tape {
    position: absolute;
    bottom: var(--space-2);
    left: 50%;
    transform: translateX(-50%);
    background: #111;
    color: #eee;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2rem;
    padding: 4px 16px;
    text-transform: uppercase;
    border: 1px solid #333;
  }

  /* ─── VITAL STATISTICS ─── */
  .data-box {
    margin-bottom: var(--space-4);
    border: 1px solid var(--bg4);
    background: var(--bg3);
  }

  .classified-redacted {
    display: block;
    background: var(--color-red);
    color: #ccc;
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.24rem;
    text-align: center;
    text-transform: uppercase;
    padding: 6px var(--space-2);
  }

  .vitals {
    padding: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    line-height: 1.8;
    color: var(--text4);
    white-space: pre-wrap;
    margin: 0;
  }

  /* ─── PROFILE BODY ─── */
  .profile-body {
    position: relative;
    z-index: 1;
  }

  .agent-name {
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    font-weight: 800;
    color: var(--text1);
    margin: 0 0 var(--space-2);
    letter-spacing: 0.04rem;
  }

  .agent-subtitle {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 400;
    color: var(--accent-blue);
    letter-spacing: 0.06rem;
    display: block;
    margin-top: 2px;
  }

  .agent-quote {
    border-left: 2px solid var(--text-accent-dim);
    padding: var(--space-2) var(--space-3);
    margin: var(--space-3) 0;
    font-size: 0.78rem;
    line-height: 1.6;
    font-style: italic;
    color: var(--text5);
    background: var(--accent-blue-subtle);
  }

  .agent-section {
    margin-bottom: var(--space-4);
  }

  .agent-section-label {
    display: inline-block;
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.2rem;
    text-transform: uppercase;
    color: var(--color-amber);
    border-bottom: 1px solid var(--border-faint);
    padding-bottom: 2px;
    margin-bottom: var(--space-2);
  }

  .agent-section p {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--text5);
    margin: 0;
  }

  .agent-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .agent-list li {
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--text5);
    padding: var(--space-1) 0;
    border-bottom: 1px solid var(--border-faint);
  }

  .agent-list li:last-child {
    border-bottom: none;
  }

  .agent-list li strong {
    color: var(--text3);
    font-weight: 700;
  }

  /* ─── REDACTED BLOCK ─── */
  .redacted-block {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: var(--space-4);
    padding: var(--space-2);
    border: 1px dashed var(--bg4);
  }

  .redacted-bar {
    display: block;
    height: 14px;
    background: #111;
    width: 100%;
  }

  /* ─── INK STAMP ─── */
  .ink-stamp {
    position: absolute;
    bottom: 40px;
    right: 30px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.14rem;
    text-align: center;
    text-transform: uppercase;
    line-height: 1.3;
    padding: 6px 12px;
    border: 3px solid;
    transform: rotate(-12deg);
    opacity: 0.55;
    pointer-events: none;
    z-index: 3;
  }

  .nigel-stamp {
    color: var(--accent-blue);
    border-color: var(--accent-blue);
  }

  .clive-stamp {
    color: var(--color-red);
    border-color: var(--color-red);
  }

  /* ─── ODD COUPLE SECTION ─── */
  .odd-couple {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin: var(--space-5) 0;
  }

  .odd-couple__item {
    background: var(--bg2);
    border-left: 3px solid var(--accent-blue);
    padding: var(--space-4);
  }

  .odd-couple__item:last-child {
    border-left-color: var(--color-red);
  }

  .odd-couple__label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.2rem;
    text-transform: uppercase;
    color: var(--accent-blue);
    display: block;
    margin-bottom: var(--space-2);
  }

  .odd-couple__item:last-child .odd-couple__label {
    color: var(--color-red);
  }

  .odd-couple__item p {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--text5);
    margin: 0;
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 800px) {
    .files-grid {
      grid-template-columns: 1fr;
    }

    .odd-couple {
      grid-template-columns: 1fr;
    }

    .ink-stamp {
      bottom: 20px;
      right: 20px;
      font-size: 0.6rem;
    }
  }
</style>