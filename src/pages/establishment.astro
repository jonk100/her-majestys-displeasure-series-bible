---
import Layout from "../layouts/Layout.astro";
import Section from "../components/layout/Section.astro";
import Container from "../components/layout/Container.astro";
import Footer from "../components/layout/Footer.astro";
import ClassifiedBand from "../components/ui/ClassifiedBand.astro";
import PitchDeckNav from "../components/ui/PitchDeckNav.astro";
import Eyebrow from "../components/typography/Eyebrow.astro";
import Heading from "../components/typography/Heading.astro";
import Rule from "../components/typography/Rule.astro";
import ThreatBand from "@/components/ui/ThreatBand.astro";
import QuoteBand from "@/components/ui/QuoteBand.astro";
import VitalsBox from "@/components/characters/VitalsBox.astro";
import ProfileCard from "@/components/characters/ProfileCard.astro";
import ProfileSection from "@/components/characters/ProfileSection.astro";
import AgentList from "@/components/characters/AgentList.astro";
import "@/styles/global.css";

// @TODO: wrap in new PitchDeckLayout, replacing Layout
// @TODO: see if SmallProfileCard can be used here or integrated with ProfileCard
---

<Layout title="Crown — Executive Briefing // Special Intervention Committee">
  <ClassifiedBand label="TOP SECRET — CROWN SPECIAL INTERVENTION COMMITTEE" />
  <!-- prettier-ignore-start -->
  <!-- ─── PAGE HEADER ─── -->
  <Section variant="black" spacing="md">
    <Eyebrow>Executive Briefing</Eyebrow>
    <Heading level={2} variant="section">The <em>Establishment</em></Heading>
    <Rule />
<ThreatBand line1="EXECUTIVE BRIEFING // CROWN SPECIAL INTERVENTION COMMITTEE TARGET" line2="SUBJECTS: THE LIVERPOOL SOUND MATRIX" />

    <p class="prose page-intro">
      The architects of the conspiracy. The wounded patriarch. The cold strategist. Two men who believed the machinery of the state could silence a song.
    </p>
  </Section>
<!-- prettier-ignore-end -->
  <!-- ─── SPLIT-SCREEN FILES ─── -->
  <Section variant="black" spacing="md">
    <div class="files-grid">
      <!-- ═══════════════════════════════════════════ -->
      <!-- PRINCE PHILIP -->
      <!-- ═══════════════════════════════════════════ -->
      <ProfileCard
        variant="crown"
        photo="/phillip.jpg"
        photoAlt="Surveillance photograph — HRH Prince Philip"
        photoLabel="HRH PRINCE PHILIP"
        badge="THE CROWN"
        name="PRINCE PHILIP"
        subtitle="// The Wounded Patriarch"
        quote="They are four working-class boys from Liverpool who play guitars, Dickie. If the British Empire cannot successfully direct the movements of a skiffle band, then what on Earth are we keeping the guards around for?"
        class="personnel-file"
      >
        <VitalsBox
          docRef="CROWN-CSIC-001"
          status="PRINCIPAL // PRIMARY ANTAGONIST"
          items={[
            { key: "AGE", value: "44 [1965] / 49 [1970]" },
            { key: "ROLE", value: "CONSORT TO THE SOVEREIGN" },
            { key: "PRIMARY MOTIVE", value: "WOUNDED ARISTOCRATIC PRIDE" },
          ]}
          slot="vitals"
        />
        <ProfileSection label="The Hook" accent="amber">
          <p>
            The ultimate architect of the conspiracy. Driven by deeply wounded aristocratic pride, he transforms a petty slight into a multi-year, multi-million pound covert royal
            vendetta.
          </p>
        </ProfileSection>

        <ProfileSection label="The Comedy & Tragedy" accent="amber">
          <p>
            Philip is filmed with razor-sharp, Wes Anderson-style symmetry — always dead-center in massive, silent, cavernous palace rooms. He treats popular music not as art, but
            as an orderly military campaign he is losing. His progression throughout the series details his complete moral corruption, escalating from simple psychological sabotage
            to demanding a live-fire assassination when John returns his MBE.
          </p>
        </ProfileSection>

        <ProfileSection label="The Narrative Trajectory" accent="amber">
          <AgentList
            items={[
              {
                term: "1965 — The Offended Patriarch",
                body: 'John\'s "killing people" comment at the MBE ceremony transforms Philip from dutiful consort to vengeful conspirator. He convenes the Committee for National Decorum and recruits Mountbatten.',
              },
              {
                term: "1968 — The Obsessed Strategist",
                body: "Increasingly consumed by the campaign. Each success feeds his righteousness; each setback deepens his obsession. He satisfies his satisfaction through chaotic, uncontrollable channels that never match his precise planning.",
              },
              {
                term: "1970 — The Failed Avenger",
                body: "John's MBE return triggers Philip's final escalation to assassination. The farcical failure leaves him with no victory — only the sordid evidence of his conspiracy and the quiet humiliation of total defeat. He has transformed from protector to destroyer.",
              },
            ]}
          />
        </ProfileSection>

        <!-- Redacted lines -->
        <div class="redacted-block">
          <span class="redacted-bar"></span>
          <span class="redacted-bar" style="width: 65%;"></span>
          <span class="redacted-bar" style="width: 80%;"></span>
        </div>

        <!-- Ink Stamp -->
        <div class="ink-stamp philip-stamp">MORAL<br />CORRUPTION</div>
      </ProfileCard>

      <!-- ═══════════════════════════════════════════ -->
      <!-- LORD MOUNTBATTEN -->
      <!-- ═══════════════════════════════════════════ -->
      <ProfileCard
        variant="crown"
        photo="/mountbatten-01.jpg"
        photoAlt="Surveillance photograph — Lord Mountbatten"
        photoLabel="LORD MOUNTBATTEN"
        badge="THE CROWN"
        name="LORD MOUNTBATTEN"
        subtitle="// The Cold Strategist"
        quote="A crisis is simply an un-choreographed transition of power. If the boy dies, we don't mourn him. We manage the vacuum."
        class="personnel-file"
      >
        <VitalsBox
          docRef="CROWN-CSIC-002"
          status="PRINCIPAL // STRATEGIC ARCHITECT"
          items={[
            { key: "AGE", value: "65 [1965] / 70 [1970]" },
            { key: "ROLE", value: "ADMIRAL OF THE FLEET (RET.)" },
            { key: "PRIMARY WEAPON", value: "WARTIME PSYCHOLOGICAL OPERATIONS" },
          ]}
          slot="vitals"
        />
        <ProfileSection label="The Hook" accent="amber">
          <p>
            Prince Philip's elegant, terrifying strategic mentor. A legendary veteran of wartime psychological operations who views the counter-culture explosion purely as a
            fascinating Cold War case study in soft-power containment.
          </p>
        </ProfileSection>

        <ProfileSection label="The Role" accent="amber">
          <p>
            The smooth, calculating corporate brain backing Philip's emotional obsession. Mountbatten is the man who looks at the tragic, sudden death of The Beatles' real-world
            manager, Brian Epstein, and instantly maps it out on a blackboard as a <em>"sudden, unexpected tactical advantage"</em> to be exploited by MI5.
          </p>
        </ProfileSection>

        <ProfileSection label="The Narrative Trajectory" accent="amber">
          <AgentList
            items={[
              {
                term: "1965 — The Strategic Architect",
                body: "Recruited by Philip after John's MBE gaffe. Applies the same analytical rigor he used for D-Day planning to designing Operation Minuet.",
              },
              {
                term: "1968 — The Fascinated Observer",
                body: 'Watches his strategies succeed through unexpected channels — the targets\' own neuroses rather than direct manipulation. Documents these "psychological ricochets" with professional satisfaction and private bewilderment.',
              },
              {
                term: "1970 — The Pragmatic Realist",
                body: "Reluctantly designs the charity concert assassination plot while privately doubting its wisdom. After the farcical failure, oversees the cleanup with professional detachment, having learned that cultural influence cannot be defeated through conventional warfare — only outlasted.",
              },
            ]}
          />
        </ProfileSection>

        <!-- Redacted lines -->
        <div class="redacted-block">
          <span class="redacted-bar" style="width: 55%;"></span>
          <span class="redacted-bar" style="width: 75%;"></span>
          <span class="redacted-bar"></span>
        </div>

        <!-- Ink Stamp -->
        <div class="ink-stamp mountbatten-stamp">PROJECT<br />COMPROMISED</div>
      </ProfileCard>
    </div>
  </Section>
  <!-- ─── OPERATIONAL POST-MORTEM ─────────── -->
  <Section variant="paper" spacing="md" style="max-width: 980px; margin: 0 auto;">
    <Container>
      <Eyebrow>Epilogue — 1980</Eyebrow>
      <Heading level={2} variant="section">Cold Storage <em>Administrative Outpost</em></Heading>
      <Rule />

<ThreatBand
><!-- prettier-ignore -->{/* prettier-ignore */}<!-- prettier-ignore -->
---------------------------------------------------------------------------------------- 
OPERATIONAL POST-MORTEM (EPILOGUE: 1980) 
LOCATION: COLD STORAGE ADMINISTRATIVE OUTPOST // THE FALKLAND ISLANDS 
STATUS: ALL FILES CLOSED. SUBJECTS EXILED. 
----------------------------------------------------------------------------------------
      </ThreatBand>
      <p class="prose">
        The final visual beat of these files shows Nigel and Clive sitting across from each other at identical desks in a frozen room at the bottom of the world — sent into exile
        by an embarrassed government.
      </p>

      <div class="exile-scene">
        <QuoteBand>
          <span class="exile-char">Clive</span>
          <p>Still wears his high-society tweed coat while analyzing the behavior of the local sheep using strict spy methodology.</p>
        </QuoteBand>
        <QuoteBand>
          <span class="exile-char">Nigel</span>
          <p>Silently watches the clock, waiting for a pension that will never arrive. The machine, finally, at rest.</p>
        </QuoteBand>
      </div>

      <hr />
      <p class="prose">
        The architects are safe. Their agents are punished. The conspiracy is buried. And a lone madman in New York achieves in a single afternoon what the entire apparatus of the
        Crown could not accomplish in five years. The universe, as ever, is indifferent.
      </p>
    </Container>
  </Section>

  <!-- ─── NAVIGATION ─── -->
  <PitchDeckNav current="/establishment" />

  <!-- ─── FOOTER ─── -->
  <Footer />
</Layout>

<style>
  hr {
    margin: 1rem;
    color: transparent;
  }

  /* ─── PAGE INTRO ─── */
  .page-intro {
    max-width: 600px;
    color: var(--text-muted);
  }

  /* ─── FILES GRID ─── */
  .files-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    background: var(--bg);
  }

  /* ─── PERSONNEL FILE ─── */
  /*
   * These styles augment ProfileCard's own padding/border with the
   * establishment-specific data-box, paperclip, stamps, and redaction blocks.
   * ProfileCard handles photo, badge, name, quote, and section layout.
   */
  .personnel-file {
    position: relative;
    background: var(--bg2);
    border: var(--border-faint);
    font-family: var(--font-mono);
    overflow: hidden;
  }

  /* ─── REDACTED BLOCK ─── */
  .redacted-block {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: var(--space-4);
    padding: var(--space-2);
    border: 1px dashed var(--border-faint);
  }

  .redacted-bar {
    display: block;
    height: 14px;
    background: #111;
    width: 100%;
  }

  /* ─── INK STAMP ─── */
  .ink-stamp {
    position: absolute;
    bottom: 40px;
    right: 30px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.14rem;
    text-align: center;
    text-transform: uppercase;
    line-height: 1.3;
    padding: 6px 12px;
    border: 3px solid;
    transform: rotate(-12deg);
    opacity: 0.55;
    pointer-events: none;
    z-index: 3;
  }

  .philip-stamp {
    color: var(--color-red);
    border-color: var(--color-red);
  }

  .mountbatten-stamp {
    color: var(--accent-blue);
    border-color: var(--accent-blue);
  }

  /* ─── EXILE SCENE ─── */
  .exile-scene {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: var(--space-1);
  }

  .exile-char {
    font-family: var(--font-mono);
    font-weight: 700;
    letter-spacing: 0.2rem;
    text-transform: uppercase;
    color: var(--text-muted);
    display: block;
    margin-bottom: var(--space-1);
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 800px) {
    .files-grid {
      grid-template-columns: 1fr;
    }

    .exile-scene {
      grid-template-columns: 1fr;
    }

    .ink-stamp {
      bottom: 20px;
      right: 20px;
      font-size: 0.6rem;
    }
  }
</style>
