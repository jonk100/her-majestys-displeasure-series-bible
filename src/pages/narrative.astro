---
import Layout from "../layouts/Layout.astro";
import Section from "../components/layout/Section.astro";
import Container from "../components/layout/Container.astro";
import Footer from "../components/layout/Footer.astro";
import ClassifiedBand from "../components/ui/ClassifiedBand.astro";
import PitchDeckNav from "../components/ui/PitchDeckNav.astro";
import Eyebrow from "../components/typography/Eyebrow.astro";
import Heading from "../components/typography/Heading.astro";
import Rule from "../components/typography/Rule.astro";
import { type EpisodeData, episodeData } from "@/data/episodeSynopsis";
import PitchDeckLayout from "@/layouts/PitchDeckLayout.astro";
import "@/styles/global.css";

const episodes = episodeData;

// @TODO: turn the episode timeline into a component
---

<PitchDeckLayout
  title="The <em>Narrative Arc</em>"
  currentPath="/narrative"
  eyebrow="Season Outline"
  classificationLabel="TOP SECRET — MI5 EXECUTIVE BRIEFING // NARRATIVE PROTOCOL"
>
  <p slot="header">
    Follow along below through the <strong>parallel chronologies</strong> of Her Majesty's Displeasure: a five-year collision course between the unyielding machinery
    of the British State and the fragile, beautiful chaos of a cultural revolution.
  </p>

  <!-- ─── VERTICAL TWO-COLUMN TIMELINE ─── -->
  <Section variant="black" spacing="md">
    <Container>
      <!-- Column headers -->
      <div class="timeline-headers">
        <div class="col-header col-header--mi5">
          <span>Crown &amp; MI5</span>
          <span class="col-pip col-pip--mi5"></span>
        </div>
        <div><!-- spine gap --></div>
        <div class="col-header col-header--beatles">
          <span class="col-pip col-pip--beatles"></span>
          <span>The Beatles</span>
        </div>
      </div>

      <!-- Timeline body: 1fr [spine] 1fr grid -->
      <div class="timeline-body">
        <!-- Vertical spine line (sits behind the grid cells) -->
        <div class="spine-line" aria-hidden="true"></div>

        <!-- We map  -->
        {
          episodes.map((ep) => (
            <>
              {/* ── MI5 cell ── */}
              <div class="ep-cell ep-cell--mi5">
                <span class="ep-label ep-label--mi5">MI5 Perspective</span>
                <h3 class="ep-title">"{ep.title}"</h3>
                <p class="ep-milestone" set:html={ep.mi5.milestone} />
                <p class="ep-body" set:html={ep.mi5.body} />
                <p class="ep-tone">{ep.mi5.tone}</p>
              </div>

              {/* ── Spine node ── */}
              <div class="ep-node" aria-label={`Episode ${ep.number}`}>
                <div>.</div>
                <div class="ep-dot">E{ep.number}</div>
                <span class="ep-year">{ep.year}</span>
              </div>

              {/* ── Beatles cell ── */}
              <div class="ep-cell ep-cell--beatles">
                <span class="ep-label ep-label--beatles">Beatles Perspective</span>
                <h3 class="ep-title">"{ep.title}"</h3>
                <p class="ep-milestone" set:html={ep.beatles.milestone} />
                <p class="ep-body" set:html={ep.beatles.body} />
                <p class="ep-tone">{ep.beatles.tone}</p>
              </div>
            </>
          ))
        }
      </div>
    </Container>
  </Section>

</PitchDeckLayout>

<style>
  /* ─── COLUMN HEADERS ─── */
  .timeline-headers {
    display: grid;
    grid-template-columns: 1fr var(--spine-w) 1fr;
    margin-bottom: var(--space-2);
    border-bottom: 2px solid var(--text-accent-subtle);
    padding-bottom: var(--space-3);
  }

  .col-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--fs3);
    font-weight: 800;
    letter-spacing: 0.1rem;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .col-header--mi5 {
    justify-content: flex-end;
  }

  .col-header--beatles {
    justify-content: flex-start;
  }

  .col-pip {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .col-pip--mi5 {
    background: #c82b2b;
  }

  .col-pip--beatles {
    background: var(--accent-blue);
  }

  /* ─── TIMELINE BODY: 3-column grid ─── */
  :root {
    --spine-w: 80px;
  }

  .timeline-body {
    display: grid;
    grid-template-columns: 1fr var(--spine-w) 1fr;
    position: relative;
  }

  /* ─── SPINE LINE: runs the full height behind the grid ─── */
  .spine-line {
    position: absolute;
    top: 0;
    bottom: 0;

    /*
     * Centre of the spine column:
     * left edge of spine = 1fr wide left column, so we use
     * calc(). The spine column is var(--spine-w) wide, so
     * the midpoint sits at 50% + half the spine width.
     */
    left: calc(50% - 0.5px);
    width: 1px;
    background: var(--border);
    z-index: 0;
    pointer-events: none;
  }

  /* ─── SPINE NODE ─── */
  .ep-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-8) 0;
    position: relative;
    z-index: 1;
    gap: var(--space-2);
  }

  /** The circular episode number badge on the spine */
  .ep-dot {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: var(--fs3);
    font-weight: 700;
    color: var(--text-muted);
    position: relative;
    z-index: 2;
    flex-shrink: 0;
  }

  /** Short date label below the spine dot */
  .ep-year {
    font-family: var(--font-mono);
    font-size: var(--fs0);
    font-weight: 400;
    color: var(--text4);
    letter-spacing: 0.05em;
    text-align: center;
    line-height: 1.4;
  }

  /* ─── EPISODE CELLS ─── */
  .ep-cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
    border-bottom: 1px solid var(--text-accent-muted);
  }

  .ep-cell--mi5 {
    text-align: right;
    align-items: flex-end;
    padding-right: var(--space-3);
  }

  .ep-cell--beatles {
    text-align: left;
    align-items: flex-start;
    padding-left: var(--space-3);
  }

  /* ─── CELL TYPOGRAPHY ─── */

  /** "MI5 Perspective" / "Beatles Perspective" eyebrow label */
  .ep-label {
    font-family: var(--font-mono);
    font-size: var(--fs1);
    font-weight: 800;
    letter-spacing: 0.1rem;
    text-transform: uppercase;
  }

  .ep-label--mi5 {
    color: var(--accent-red, #c82b2b);
    background: #98020259;
    padding: 0 0 0 2rem;
  }

  .ep-label--beatles {
    color: var(--accent-blue);
    background: #2089b931;
    padding: 0 1rem 0 0;
  }

  /** Episode title (shared across both columns) */
  .ep-title {
    font-family: var(--font-sans);
    font-size: var(--fs3);
    font-weight: 800;
    line-height: 1;
    color: var(--text4);
  }

  /** Key historical milestone shown in italic */
  .ep-milestone {
    font-family: var(--font-sans);
    font-size: var(--fs2);
    font-style: italic;
    color: var(--text5);
    line-height: 1.5;
  }

  /** Main narrative body text */
  .ep-body {
    font-family: var(--font-sans);
    font-size: var(--fs2);
    line-height: 1.5;
    color: var(--text3);
  }

  /** Tonal descriptor shown at the bottom of each cell */
  .ep-tone {
    font-family: var(--font-mono);
    font-size: var(--fs2);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding-top: var(--space-2);
    border-top: 1px solid var(--border);
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 700px) {
    :root {
      --spine-w: 48px;
    }

    .ep-cell {
      padding: var(--space-3) var(--space-2);
    }

    .ep-year {
      display: none;
    }
  }
</style>
