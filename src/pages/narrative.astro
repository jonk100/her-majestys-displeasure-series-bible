---
import Layout from "../layouts/Layout.astro";
import Section from "../components/layout/Section.astro";
import Container from "../components/layout/Container.astro";
import Footer from "../components/layout/Footer.astro";
import ClassifiedBand from "../components/ui/ClassifiedBand.astro";
import PitchDeckNav from "../components/ui/PitchDeckNav.astro";
import Eyebrow from "../components/typography/Eyebrow.astro";
import Heading from "../components/typography/Heading.astro";
import Rule from "../components/typography/Rule.astro";
import "@/styles/global.css";

/**
 * @typedef {Object} EpisodeData
 * @property {number} number - Episode number (1–6)
 * @property {string} year - Date/year label shown on the spine node
 * @property {string} title - Shared episode title (shown on both sides)
 * @property {Object} mi5 - MI5/Crown perspective content
 * @property {string} mi5.milestone - Key story beat from the MI5 POV
 * @property {string} mi5.body - Narrative summary from the MI5 POV (HTML allowed)
 * @property {string} mi5.tone - Tonal descriptor for the MI5 side
 * @property {Object} beatles - Beatles perspective content
 * @property {string} beatles.milestone - Key story beat from the Beatles POV
 * @property {string} beatles.body - Narrative summary from the Beatles POV (HTML allowed)
 * @property {string} beatles.tone - Tonal descriptor for the Beatles side
 */

/** @type {EpisodeData[]} */
const episodes = [
  {
    number: 1,
    year: "Oct 1965",
    title: "A Toast to Her Majesty",
    mi5: {
      milestone: "Lennon's quip triggers Philip's cold fury",
      body: `Phillip bypasses the PM and tasks overlooked civil servants Nigel Finch and Clive Barrow
             with <em>Operation Minuet</em>. Nigel wants his pension. Clive thinks history has
             handed him a canvas.`,
      tone: "Crisp, symmetrical satire of bureaucratic stagnation.",
    },
    beatles: {
      milestone: "The MBE Ceremony at Buckingham Palace",
      body: `The lads from Liverpool smoke a joint in the royal bathroom to steady their nerves,
             then collect their medals. John's throwaway quip sets a chain of events in motion
             that will echo across a decade.`,
      tone: "Innocent charm masking the cultural revolution ahead.",
    },
  },
  {
    number: 2,
    year: "1966",
    title: "The Klaus Technique",
    mi5: {
      milestone:
        "Nigel sparks George's sitar obsession; Clive amplifies the Jesus quote.",
      body: `Nigel leaves an Eastern philosophy text on George's amp. Clive adopts the persona of
             a pretentious German art critic named "Klaus" to infiltrate John's avant-garde circle, and
             works overtime to weaponize the Jesus quote against the band.`,
      tone: "Fast-paced institutional farce. Paranoid surveillance logs vs. effortless creative explosion.",
    },
    beatles: {
      milestone:
        "<em>Rubber Soul</em> & <em>Revolver</em> sessions; 'More popular than Jesus'",
      body: `As the band continues to push every musical boundary, <em>Revolver</em> marks their creative peak —
             just in time for John's "more popular than Jesus" quote to ignite outrage across the Bible Belt. 
             The band decides their touring days have come to an end.`,
      tone: "Creative explosion meets cultural backlash. Confidence grows even as the establishment pushes back.",
    },
  },
  {
    number: 3,
    year: "Aug 1967",
    title: "Tactical Advantages",
    mi5: {
      milestone:
        "Philip and Mountbatten evaluate Epstein's death as a 'tactical advantage'",
      body: `<em>Sgt. Pepper</em> leaves the agents feeling utterly defeated. Then Brian Epstein
             overdoses. In a chilling palace meeting, the Crown views the band's beloved manager
             not as a human tragedy but as an unexpected opportunity — and steps into the power vacuum.`,
      tone: "The turning point. Satire trades lightness for cold psychological weight.",
    },
    beatles: {
      milestone:
        "<em>Sgt. Pepper's Lonely Hearts Club Band</em> is released; later, the death of Brian Epstein.",
      body: `The band releases their masterpiece studio album. They stand at the peak of their cultural authority,
             with nothing in their way. Then, their manager, protector, mediator, anchor — Brian Epstein - is gone. 
             The vacuum he leaves will eventually pull them apart.`,
      tone: "Creative peak meets personal tragedy. The beginning of the end for the band's unity.",
    },
  },
  {
    number: 4,
    year: "1968",
    title: "The Frequency of Revolution",
    mi5: {
      milestone:
        "Clive convinces himself 'Revolution 9' contains KGB launch codes",
      body: `Secretly listening in to a fractured broadcast of the White Album sessions, Clive stays
             awake for days parsing avant-garde noise as Soviet intelligence. Nigel watches his
             partner unravel.`,
      tone: "Claustrophobic and darkly funny. The agents begin to mirror the deterioration they were ordered to cause.",
    },
    beatles: {
      milestone: "The <em>White Album</em> recordings; Yoko Ono arrives.",
      body: `The band records a sprawling double album in a state of mutual exhaustion. John's
             deepening bond with Yoko Ono intensifies the fractures — four enormous egos turning
             inward, consuming the unity that made them great.`,
      tone: "Fracture and experimentation. The creative energy turns corrosive.",
    },
  },
  {
    number: 5,
    year: "Late 1969",
    title: "Operation Elegy",
    mi5: {
      milestone: "Philip raises the stakes; Nigel's conscience finally breaks",
      body: `Nigel's forged knighthood letter backfires spectacularly as John returns his MBE.
             Philip demands a permanent solution. Faced with actual blood on his hands, Nigel finds
             he doesn't have the stomach for it anymore.`,
      tone: "High-stakes espionage thriller. A moral crisis managed from inside a cubicle.",
    },
    beatles: {
      milestone: "The <em>Get Back</em> sessions; John returns his MBE",
      body: `The band endures the grueling, videotaped Get Back sessions under Twickenham's
             fluorescent lights. John makes a proud trip to the post office to make a protest
             and to publicly reject the establishment that once feted him.`,
      tone: "The final spiral. Conflicts reach their climax; the world descends into chaos around them.",
    },
  },
  {
    number: 6,
    year: "1970, 1980",
    title: "The Ultimate Cosmic Joke",
    mi5: {
      milestone:
        "Nigel quietly tanks Elegy; a dark, cold exile; the radio crackles",
      body: `Nigel orchestrates the operation's failure through bad paperwork and logistics.
             As the agents are exiled to a remote office in the Falklands, the band splits
             through pure, organic means. Years later, a transistor radio announces John Lennon's murder
             by a lone, deranged fan. Two frozen, forgotten old men stare at each other as the wind howls outside.`,
      tone: "Crushing, brilliant dramatic irony. Their secret war was fought for absolutely nothing.",
    },
    beatles: {
      milestone:
        "The Rooftop Concert; the breakup and divorce; and a 1980 epilogue",
      body: `The Beatles make one last performance on the roof of Apple Corps. Shortly after, it's over. 
             Not with a bang. With lawyers and grudges, paperwork and emotions. Each of the Beatles goes on to have a 
             successful solo career, but a decade later, John Lennon steps out of 
             the Dakota building in New York, where he's shot dead by a stranger who loved his music.`,
      tone: "Ironic tragedy. The Crown's goal achieved by a madman in an afternoon — after five years of expensive failure.",
    },
  },
];
---

<Layout title="MI5 Executive Briefing — Narrative Arc">
  <ClassifiedBand
    label="TOP SECRET — MI5 EXECUTIVE BRIEFING // NARRATIVE PROTOCOL"
  />

  <!-- ─── PAGE HEADER ─── -->
  <Section variant="dark" spacing="md">
    <!-- <Container> -->
      <Eyebrow>Season Outline</Eyebrow>
      <Heading level={2} variant="section">The <em>Narrative Arc</em></Heading>
      <Rule />
    <!-- </Container> -->
  </Section>

  <!-- ─── INTRO ─── -->
  <!-- <Section variant="paper" spacing="lg">
    <Container>
      <p class="prose">
        The narrative arc follows a split tonal timeline, presenting the
        parallel worlds of the Crown/MI5 and the Beatles/Apple Corps side by
        side as they inch toward their inevitable intersection.
      </p>
    </Container>
  </Section> -->

  <!-- ─── VERTICAL TWO-COLUMN TIMELINE ─── -->
  <Section variant="black" spacing="md">
    <Container>
      <!-- Column headers -->
      <div class="timeline-headers">
        <div class="col-header col-header--mi5">
          <span>Crown &amp; MI5</span>
          <span class="col-pip col-pip--mi5"></span>
        </div>
        <div><!-- spine gap --></div>
        <div class="col-header col-header--beatles">
          <span class="col-pip col-pip--beatles"></span>
          <span>The Beatles</span>
        </div>
      </div>

      <!-- Timeline body: 1fr [spine] 1fr grid -->
      <div class="timeline-body">
        <!-- Vertical spine line (sits behind the grid cells) -->
        <div class="spine-line" aria-hidden="true"></div>

        {
          episodes.map((ep) => (
            <>
              {/* ── MI5 cell ── */}
              <div class="ep-cell ep-cell--mi5">
                <span class="ep-label ep-label--mi5">MI5 Perspective</span>
                <h3 class="ep-title">"{ep.title}"</h3>
                <p class="ep-milestone" set:html={ep.mi5.milestone} />
                <p class="ep-body" set:html={ep.mi5.body} />
                <p class="ep-tone">{ep.mi5.tone}</p>
              </div>

              {/* ── Spine node ── */}
              <div class="ep-node" aria-label={`Episode ${ep.number}`}>
                <div>.</div>
                <div class="ep-dot">E{ep.number}</div>
                <span class="ep-year">{ep.year}</span>
              </div>

              {/* ── Beatles cell ── */}
              <div class="ep-cell ep-cell--beatles">
                <span class="ep-label ep-label--beatles">
                  Beatles Perspective
                </span>
                <h3 class="ep-title">"{ep.title}"</h3>
                <p class="ep-milestone" set:html={ep.beatles.milestone} />
                <p class="ep-body" set:html={ep.beatles.body} />
                <p class="ep-tone">{ep.beatles.tone}</p>
              </div>
            </>
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- ─── NAVIGATION ─── -->
  <PitchDeckNav current="/narrative" />

  <!-- ─── FOOTER ─── -->
  <Footer />
</Layout>

<style>

  /* ─── COLUMN HEADERS ─── */
  .timeline-headers {
    display: grid;
    grid-template-columns: 1fr var(--spine-w) 1fr;
    margin-bottom: var(--space-2);
    border-bottom: 2px solid var(--text-accent-subtle);
    padding-bottom: var(--space-3);
  }

  .col-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--fs3);
    font-weight: 800;
    letter-spacing: 0.1rem;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .col-header--mi5 {
    justify-content: flex-end;
  }

  .col-header--beatles {
    justify-content: flex-start;
  }

  .col-pip {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .col-pip--mi5 {
    background: #c82b2b;
  }

  .col-pip--beatles {
    background: var(--accent-blue);
  }

  /* ─── TIMELINE BODY: 3-column grid ─── */
  :root {
    --spine-w: 80px;
  }

  .timeline-body {
    display: grid;
    grid-template-columns: 1fr var(--spine-w) 1fr;
    position: relative;
  }

  /* ─── SPINE LINE: runs the full height behind the grid ─── */
  .spine-line {
    position: absolute;
    top: 0;
    bottom: 0;

    /*
     * Centre of the spine column:
     * left edge of spine = 1fr wide left column, so we use
     * calc(). The spine column is var(--spine-w) wide, so
     * the midpoint sits at 50% + half the spine width.
     */
    left: calc(50% - 0.5px);
    width: 1px;
    background: var(--border);
    z-index: 0;
    pointer-events: none;
  }

  /* ─── SPINE NODE ─── */
  .ep-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-8) 0;
    position: relative;
    z-index: 1;
    gap: var(--space-2);
  }

  /** The circular episode number badge on the spine */
  .ep-dot {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: var(--fs3);
    font-weight: 700;
    color: var(--text-muted);
    position: relative;
    z-index: 2;
    flex-shrink: 0;
  }

  /** Short date label below the spine dot */
  .ep-year {
    font-family: var(--font-mono);
    font-size: var(--fs1);
    font-weight: 400;
    color: var(--text4);
    letter-spacing: 0.05em;
    text-align: center;
    line-height: 1.4;
  }

  /* ─── EPISODE CELLS ─── */
  .ep-cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
    border-bottom: 1px solid var(--text-accent-muted);
  }

  .ep-cell--mi5 {
    text-align: right;
    align-items: flex-end;
    padding-right: var(--space-3);
  }

  .ep-cell--beatles {
    text-align: left;
    align-items: flex-start;
    padding-left: var(--space-3);
  }

  /* ─── CELL TYPOGRAPHY ─── */

  /** "MI5 Perspective" / "Beatles Perspective" eyebrow label */
  .ep-label {
    font-family: var(--font-mono);
    font-size: var(--fs1);
    font-weight: 800;
    letter-spacing: 0.1rem;
    text-transform: uppercase;
  }

  .ep-label--mi5 {
    color: var(--accent-red, #c82b2b);
    background: #98020259;
    padding: 0 0 0 2rem;
  }

  .ep-label--beatles {
    color: var(--accent-blue);
    background: #2089b931;
    padding: 0 1rem 0 0;
  }

  /** Episode title (shared across both columns) */
  .ep-title {
    font-family: var(--font-sans);
    font-size: var(--fs3);
    font-weight: 800;
    line-height: 1;
    color: var(--text4);
  }

  /** Key historical milestone shown in italic */
  .ep-milestone {
    font-family: var(--font-sans);
    font-size: var(--fs2);
    font-style: italic;
    color: var(--text5);
    line-height: 1.5;
  }

  /** Main narrative body text */
  .ep-body {
    font-family: var(--font-sans);
    font-size: var(--fs3);
    line-height: 1.65;
    color: var(--text3);
  }

  /** Tonal descriptor shown at the bottom of each cell */
  .ep-tone {
    font-family: var(--font-mono);
    font-size: var(--fs2);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding-top: var(--space-2);
    border-top: 1px solid var(--border);
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 700px) {
    :root {
      --spine-w: 48px;
    }

    .ep-cell {
      padding: var(--space-3) var(--space-2);
    }

    .ep-year {
      display: none;
    }
  }
</style>
