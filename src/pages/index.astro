---
/**
 * Main Index Page — Mobile-First Re-engineering.
 * Composed entirely from Design System primitives.
 */

import Layout from "../layouts/Layout.astro";
import Container from "@/design/ui/layout/Container.astro";
import Stack from "@/design/ui/layout/Stack.astro";
import Grid from "@/design/ui/layout/Grid.astro";
import SectionLabel from "@/design/ui/typography/SectionLabel.astro";
import Text from "@/design/ui/typography/Text.astro";
import Image from "@/design/ui/primitives/Image.astro";

import ClassifiedBand from "../components/ui/ClassifiedBand.astro";
import Hero from "../components/hero/Hero.astro";
import Overview from "../components/sections/home/Overview.astro";
import ToneGrid from "../components/tone/ToneGrid.astro";
import PillarGrid from "../components/pillars/PillarGrid.astro";
import CharacterCard from "../components/characters/CharacterCard.astro";
import CastGrid from "../components/characters/CastGrid.astro";
import EpisodeTimeline from "../components/episodes/EpisodeTimeline.astro";
import Footer from "../components/layout/Footer.astro";
import Section from "../components/layout/Section.astro";

import '@/styles/global.css';

import {
  hero,
  tonePanels,
  pillars,
  featuredCharacters,
  cast,
  episodes,
  epilogue,
} from "../data/her-majestys-displeasure";

---

<Layout title="Operation Minuet — Series Bible">
  <!-- ─── TOP BAND ─── -->
  <ClassifiedBand label="TOP SECRET — COMMITTEE FOR NATIONAL DECORUM" />

  <main>
    <Stack gap="none">
      
      <!-- ─── HERO ─── -->
      <Hero data={hero} />

      <!-- ─── OVERVIEW ─── -->
      <Overview />

      <!-- ─── CULTURAL THREAT ─── -->
      <Section variant="dark" spacing="lg">
        <Image 
          src="cultural-threat-assessment.png" 
          alt="Cultural Threat Assessment Map" 
          shape="landscape"
          radius="md"
          class="map-image"
        />
      </Section>

      <!-- ─── TONE ─── -->
      <Section variant="dark" spacing="xl">
        <Stack gap="xl">
          <Stack gap="md">
            <SectionLabel text="Visual Language" tone="accent" />
            <Text as="h2" type="h2">Two <em>Worlds</em></Text>
          </Stack>
          
          <Text type="body" tone="subtle" class="max-w-prose">
            Every frame is a collision. The visual language is a deliberate,
            irreconcilable clash — deadpan institutional geometry against warm,
            breathing chaos.
          </Text>

          <ToneGrid panels={tonePanels} />
        </Stack>
      </Section>

      <!-- ─── THEMES ─── -->
      <Section variant="black" spacing="xl">
        <Stack gap="xl">
          <Stack gap="md">
            <SectionLabel text="Core Themes" tone="accent" />
            <Text as="h2" type="h2">The <em>Questions</em></Text>
          </Stack>

          <Text type="body" tone="subtle" class="max-w-prose">
            Can an individual artist's authentic, chaotic rebellion survive a
            confrontation with the soulless machinery of the state — or will both be
            transformed by the encounter?
          </Text>

          <PillarGrid pillars={pillars} />
        </Stack>
      </Section>

      <!-- ─── OPERATIVES ─── -->
      <Section variant="dark" spacing="xl">
        <Stack gap="xl">
          <Stack gap="md">
            <SectionLabel text="The Operatives — B-Plot" tone="accent" />
            <Text as="h2" type="h2">The <em>Agents</em></Text>
          </Stack>

          <Text type="body" tone="subtle" class="max-w-prose">
            Two MI5 men. One a delusional artist manqué. One a weary conscience. Five
            years. The bureaucratic heart of the show.
          </Text>

          <!-- Character Cards -->
          <Grid cols={2} gap="md">
            {featuredCharacters.map((char) => (
              <a href="/mi5" class="card-link-wrapper">
                <CharacterCard character={char} />
              </a>
            ))}
          </Grid>

          <!-- Descriptions -->
          <Grid cols={2} gap="md">
            {featuredCharacters.map((agent) => (
              <div class="agent-description-box">
                <Text type="body-sm" tone="subtle" set:html={agent.description} />
              </div>
            ))}
          </Grid>
        </Stack>
      </Section>

      <!-- ─── SUPPORTING CAST ─── -->
      <Section variant="black" spacing="xl">
        <Stack gap="xl">
          <Stack gap="md">
            <SectionLabel text="Principal Characters" tone="accent" />
            <Text as="h2" type="h2">The <em>Players</em></Text>
          </Stack>

          <CastGrid items={cast} links={{
            "Prince Philip": "/establishment",
            "Lord Mountbatten": "/establishment",
            "John Lennon": "/collision",
            "Queen Elizabeth II": "/collision",
            "Paul McCartney": "/supporting-cast",
            "George Harrison": "/supporting-cast",
          }} />
        </Stack>
      </Section>

      <!-- ─── EPISODES ─── -->
      <Section variant="paper" spacing="xl">
        <Stack gap="xl">
          <Stack gap="md">
            <SectionLabel text="Episode Structure" tone="accent" />
            <Text as="h2" type="h2">The <em>Campaign</em></Text>
          </Stack>

          <Text type="body" tone="subtle" class="max-w-prose">
            Six episodes. Five years. One inevitable conclusion. Tension builds from
            bureaucratic simmer to assassination attempt — then collapses, farcically,
            to nothing. The universe wins.
          </Text>

          <EpisodeTimeline episodes={episodes} />
        </Stack>
      </Section>

      <!-- ─── EPILOGUE ─── -->
      <Section variant="dark" className="epilogue-section" spacing="xl">
        <Stack gap="xl">
          <Stack gap="md">
            <SectionLabel text="Epilogue" tone="accent" />
            <Text as="h2" type="h2">{epilogue.location}</Text>
          </Stack>

          <Stack gap="lg">
            {epilogue.paragraphs.map((p) => (
              <Text type="body" tone="subtle" set:html={p} />
            ))}
          </Stack>

          <div class="end-card-wrapper">
            {epilogue.endCard.map((line) => (
              <Text type="caption" tone="muted">{line}</Text>
            ))}
          </div>
        </Stack>
      </Section>

    </Stack>
  </main>

  <Footer />
</Layout>

<style>
  /* Base Styles */
  main {
    overflow-x: hidden;
    width: 100%;
  }

  .max-w-prose {
    max-width: 65ch;
  }

  .map-image {
    width: 100% !important;
    max-width: 900px;
    margin-inline: auto;
  }

  /* Operatives Section */
  .card-link-wrapper {
    display: block;
    transition: transform 0.2s ease, filter 0.2s ease;
  }

  .card-link-wrapper:hover {
    transform: translateY(-4px);
    filter: brightness(1.1);
  }

  .agent-description-box {
    padding: var(--space-6);
    background: var(--bg-subtle);
    border: 1px solid var(--border-faint);
    height: 100%;
  }

  /* Epilogue */
  .epilogue-section {
    position: relative;
    overflow: hidden;
  }

  .epilogue-section::before {
    content: "CLASSIFIED";
    position: absolute;
    top: 10%;
    right: -5%;
    font-family: var(--font-mono);
    font-size: clamp(4rem, 10vw, 8rem);
    font-weight: 900;
    letter-spacing: 0.1em;
    color: var(--text);
    opacity: 0.05;
    transform: rotate(-15deg);
    pointer-events: none;
  }

  .end-card-wrapper {
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-faint);
  }

  /* Responsive Overrides */
  @media (max-width: 768px) {
    .agent-description-box {
      padding: var(--space-4);
    }
  }
</style>
